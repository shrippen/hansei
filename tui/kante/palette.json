  "shape": {
    "chamfer": 16,
    "chamferSmall": 10,
    "note": "top-right corner cut on surfaces (16), buttons and tiles (10), small parts (6); a second cut bottom-left only on primary and danger buttons, dialogs and the install box. Fields stay rectangular. No border radius except icons (soft signs in hard frames) and Kante Light. Web: --chamfer, --cut-m, --cut-s. Apps: KanteStyle.chamfer / chamferSmall.",
    "cutM": 10,
    "cutS": 6,
    "controlHeights": [
      32,
      40,
      48
    ],
    "heights": {
      "small": 32,
      "medium": 40,
      "large": 48
    },
    "cutSmall": 6
  },
